# Project target: without this a fresh clone builds for the default ESP32.
CONFIG_IDF_TARGET="esp32c6"

# --- role: COPROCESSOR -----------------------------------------------------
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# WiFi: MUST stay on. This firmware replaces what currently makes the Tab5's WiFi
# work - turning it off here would leave the device without a network.
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# The opaque P4 <-> C6 byte channel. ESP-NOW will talk through it.
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y

# BLUETOOTH ON - and the decision changed after MEASURING.
#
# The first version of this left BT out, with two arguments that did not
# survive:
#
#   "more headroom in the slot" - BT costs 259KB. With it the image is at
#   1.40MB of the default slot's 1.75MB, 24% free. Plenty of headroom.
#
#   "fewer new things at once" - the opposite. The C6 is the Tab5's ONLY radio,
#   and M5Stack's firmware provides BLE through it. Removing BT is not "less
#   change", it is a REGRESSION: a device capability disappears. Keeping it makes the
#   new image more like the one already there, not less.
#
# And the remaining risk - "what if M5Stack's real slot is smaller than 1.75MB?" -
# is not a risk: if the image does not fit, esp_ota_write fails midway, and failing
# in write is safe (without `end`, the boot partition does not change). The worst case is
# one wasted attempt, and then we rebuild without BT.
#
# CONTROLLER_ONLY: the C6 runs only the controller; the stack (NimBLE/Bluedroid) lives
# on the P4 side, which is how esp_hosted was designed.
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y

# --- flash and partitions -------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- SAFETY NET -------------------------------------------------------------
# The new image comes up in PENDING state. If it does not declare itself valid, the
# bootloader goes back to the previous one on the next boot.
#
# The one doing that check is the BOOTLOADER. Flashing over the cable brings ours
# (with this option); an OTA does not replace the bootloader. That is why app_main.c has
# a SECOND net, at application level, armed only for an image that came via OTA.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- RADIO EXTRAS (contract v3): CSI, FTM, 802.15.4 -------------------------
# Each one sleeps until the P4 asks. Enabled here because reflashing the C6 is physical
# (Downloader): the flash brings everything that depends on the radio at once, and from then
# on evolution happens only on the P4 side. A CAPS bit only lights up if the flag stayed.
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=y
# The C6's other radio (802.15.4). In the 1st test it brought WiFi down (associated,
# but the router stopped answering pings): COEXISTENCE was missing - the
# app_main.c did not call esp_coex_wifi_i154_enable(), and without it the RF
# arbiter does not take 802.15.4 into account. Fixed there; the module sleeps until the P4 asks.
# If it ever needs removing: =n here, the module disappears and the C6_CAP_154 bit goes off.
CONFIG_IEEE802154_ENABLED=y

# The event task (sys_evt) runs the FTM report handler, which builds the
# message for the P4 on the stack (~300 B). The default 2304 was at the limit.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584

# Crash snapshot in the 'coredump' partition (partitions.csv): survives a
# restart, and INFO tells the P4 there is one stored.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# --- POWER -------------------------------------------------------------------
# Variable clock (DFS) so Wi-Fi releases the CPU between beacons - see the
# "CLOCK VARIAVEL" block in app_main.c. Light sleep stays off (SDIO slave).
CONFIG_PM_ENABLE=y

# --- THE HOST SLEEPS, SO DOES THE C6 (firmware c6-5) ---------------------------
# esp_hosted's "host power save": the P4 signals via the SDIO interrupt, the
# slave is torn down and this chip can enter associated light sleep;
# traffic for the host wakes it via IO2 (wire to the P4's G14). "DEEP_SLEEP" is
# the name esp_hosted gives the wake-pin option - the P4 does NOT enter
# deep sleep, it stays in light sleep and re-mounts the link (main/hal/tab5_c6_sono).
# Boot pulse off: the P4 only listens to G14 when it has asked to sleep.
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_DEEP_SLEEP=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_WAKE_HOST_ON_CP_BOOT=n
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO=2
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL_HIGH=y
# Without tickless, PM light sleep never happens; the callbacks count the sleep
# for INFO (the P4 cannot see the serial output here).
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
# The C6's BLE only sleeps together with tickless if the MAC/baseband powers down in sleep
# (bt.c requires it). Costs ~5 KB of RAM (Wi-Fi + BT retention) and saves more.
CONFIG_ESP_PHY_MAC_BB_PD=y
# Time in each PM mode (including SLEEP) in the locks table the P4 asks for
# ('c6 travas'): that is how you see, from the P4, whether light sleep happens.
CONFIG_PM_PROFILING=y
