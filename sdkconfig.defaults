# Project target: without this a fresh clone builds for the default ESP32.
CONFIG_IDF_TARGET="esp32p4"

# --- flash ---------------------------------------------------------------
# The Tab5 has 16MB. The 2MB default cannot fit an app with display + radio.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Our own table instead of IDF's "singleapp_large": it gives the app 1500K, and
# we were already at 68% of it. See partitions.csv - nvs stays at the same
# address, so the user's preferences survive the change.
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- SILICON REVISION ---------------------------------------------------
# It does NOT live here: the P4 v1.x (the Tab5s sold so far) and the v3.x need
# DIFFERENT binaries, and each one is in its own file -
# sdkconfig.defaults.chip_v1 and sdkconfig.defaults.chip_v3. The one that chooses is the
# root CMakeLists.txt (M5_CHIP, default v1); gravar.sh reads the revision of the
# connected device and chooses by itself.

# --- PSRAM ---------------------------------------------------------------
# Mandatory on the Tab5: the 720x1280 framebuffer does not fit in internal RAM.
# After the first build, open menuconfig and check mode/speed -
# the sub-options only appear once SPIRAM=y.
CONFIG_SPIRAM=y
# Large static buffers marked with EXT_RAM_BSS_ATTR go to PSRAM
# (Mesh node table, log drain, monitor history...) - internal
# SRAM is the most contended memory in the system.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# The PSRAM noinit section exists for the HEAP GUARD (main/main.cpp):
# IDF places the PSRAM heap right after it, and the aligned guard makes the heap
# start on a cache line of its own. Without this the boot crashed now and then
# in M5.begin() with the heap corrupted (see the comment in main.cpp).
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y


# --- file names on the SD card --------------------------------------------
# WITHOUT THIS FAT ONLY ACCEPTS 8.3 - eight characters before the dot. The IDF
# default is CONFIG_FATFS_LFN_NONE, and the effect is treacherous: the FOLDER is created,
# fopen of the file fails silently, and you are left with an empty directory without
# understanding why. That is exactly what happened:
# "energia.csv" (7 characters) was written all night and "satelites.csv" (9) never
# created the file.
#
# In a system where each application chooses the names of its own files, requiring
# 8.3 is a permanent trap. LFN_HEAP puts the name buffer on the heap, which is
# what there is plenty of on the P4 with PSRAM.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128

# THE CARD'S NAME (volume label) - the Files app shows the name the
# card has on the computer, instead of "Cartao". Read-only (f_getlabel).
CONFIG_FATFS_USE_LABEL=y

# UTF-8 NAMES. The IDF default delivers the long name converted to the
# code page (CP437) - and a letter CP437 does not have (ã, õ, Á, Ú) does not
# become anything: FAT returned the SHORT name ("CANCAO~1.MP3" instead of
# "Canção.mp3"). In UTF-8 readdir() delivers the name as the computer
# wrote it, and fopen() accepts the same text the screen shows. Code page 437
# still applies only to the short 8.3 names.
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- USB-A (host) ----------------------------------------------------------
# The flash drive on USB-A (services/tab5_usb). The controller's DMA buffers
# go to PSRAM: internal RAM is the most contended (see the memory
# audit), and what passes through here (music, files) does not need the last
# drop of speed.
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y

# --- console -------------------------------------------------------------
# UART as primary and USB-Serial-JTAG as secondary (the P4 default).
# CONFIG_ESP_CONSOLE_UART_DEFAULT was the value. Changed because
# the Tab5's USB-C port is the P4's NATIVE USB-Serial-JTAG (/dev/cu.usbmodem*),
# not a converter wired to UART0.
#
# With UART0 as the primary console, the logs did get through - via the
# SECONDARY console, which IDF's own Kconfig describes as OUTPUT ONLY
# (esp_system/Kconfig:312-315). But stdin was stuck on UART0, on GPIO
# 37/38, where nothing is connected: typing in the monitor went
# nowhere, and no terminal in the world would fix that.
#
# The Kconfig help says exactly this: "if you want input through
# USB_SERIAL_JTAG port, please change the primary config to
# ESP_CONSOLE_USB_SERIAL_JTAG".
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# --- FreeRTOS ------------------------------------------------------------
# 1000Hz tick: vTaskDelay gets 1ms resolution instead of 10ms.
CONFIG_FREERTOS_HZ=1000

# TWO NOTIFICATION ENTRIES PER TASK. The UI wakes on entry 1
# (kernel/core.cpp, UI_AVISO_IDX) and leaves 0 for whatever uses notifications
# underneath (stream buffers, drivers). In an old sdkconfig this key does not go in
# by itself: the code falls back to 0 and works as before - to get the separation,
# 'idf.py menuconfig' (Component config > FreeRTOS > Kernel) or delete the
# sdkconfig and build again.
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2

# --- power management ----------------------------------------------------
# STEP 1 (on): frequency DFS, WITHOUT light sleep.
# Unlocks esp_pm_configure(), which under Arduino returned ESP_ERR_NOT_SUPPORTED.
# From here on the CPU drops by itself to min_freq_mhz when NOBODY holds a
# PM lock, and rises to max_freq_mhz when someone holds ESP_PM_CPU_FREQ_MAX.
# It is not a governor measuring load: it is deterministic, driven by locks the
# drivers take without telling anyone. See tab5_power.hpp.
CONFIG_PM_ENABLE=y

# STEP 2 - automatic light sleep on idle, ON since 2026-10-16. Tickless
# all the time (when awake it only skips ticks); real LIGHT SLEEP only applies
# while idle, with the screen torn down (tab5_power_sono_leve, called by the kernel) -
# the PM locks while idle show the way is clear ('energia travas').
# Measured before: P4 97.8% idle while idle, awake at 40 MHz for nothing.
# Silicon reminder: PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP depends on
# !ESP32P4_SELECTS_REV_LESS_V3, i.e. it does NOT exist on this chip - the CPU only has its
# clock stopped in light sleep, it is not powered down.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# STEP 3 - A CABLE TO THE PC HOLDS OFF LIGHT SLEEP (2026-11-11). On the P4 the console USB
# (USB Serial/JTAG) does not work in light sleep nor after it: with the cable
# connected to the computer, idle really slept and the device HUNG until the
# watchdog restarted it ("other watchdog" restart, no core dump). The battery
# service is no use for this: it sees the cable by the current, and with the battery
# full the current drops to zero and it releases the "plugged in" state with the cable still in the PC.
# With this option the driver itself watches the SOF packets the computer sends
# every 1 ms and, while they arrive, holds an ESP_PM_NO_LIGHT_SLEEP lock. A
# wall charger (no data) sends no SOF: light sleep still applies.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Diagnostics, for when the frequency does NOT drop: makes esp_pm_dump_locks()
# print who created each lock and how long it held it. It is the tool for
# finding out whether the C6's SDIO is holding the clock up high.
# CONFIG_PM_PROFILING=y


# --- task statistics ------------------------------------------------------
# These enable the "Tarefas" (Tasks) app. Without the first, TaskStatus_t's ulRunTimeCounter
# is always zero and there is no way to calculate CPU %.
# GENERATE_RUN_TIME_STATS already selects USE_TRACE_FACILITY and
# USE_STATS_FORMATTING_FUNCTIONS by itself - no need to list them.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Adds the xCoreID field to TaskStatus_t. Depends on
# USE_STATS_FORMATTING_FUNCTIONS, which the key above already enabled.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# The time counter is esp_timer in microseconds. At 32 bits it overflows in
# ~71 minutes and the statistics turn to garbage from then on. At 64 bits, never.
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# --- optimisation ---------------------------------------------------------
# Equivalent to PlatformIO's "build_type = debug", which breaks the build
# with espidf. -Og keeps the code debuggable. Switch to _PERF when measuring.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- main task -----------------------------------------------------------
# The 3584-byte default cannot cope with M5.begin() (panel + touch + expanders).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- WiFi: SDIO to the ESP32-C6 -------------------------------------------
# The Tab5 has no radio on the P4. WiFi and BLE come from an ESP32-C6 next to it, over SDIO.
#
# esp_hosted ALREADY HAS A PRESET for this board - found by reading its Kconfig,
# before pinning the six pins by hand. It defines CLK 12, CMD 13,
# D0 11, D1 10, D2 9, D3 8 and reset 15, which are exactly those measured
# on the board. Using the preset is better: if
# Espressif fixes something, it comes for free.
#
# With the reference kit defaults (CMD 19, CLK 18, D0 14) esp_hosted gives
# "send_op_cond returned 0x107" and the board goes into a boot loop.
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y

# esp_hosted installs an __attribute__((constructor)) that runs BEFORE
# app_main and fires a task (eh_init, prio 23) doing eh_host_init() +
# eh_host_connect_to_slave(). That clashes head-on with the deny-by-default
# power profile: app_main turns off WLAN_PWR_EN (the C6 rail) at around
# 2.1s, and the SDIO probe arrives at 3.1s on an unpowered chip ->
#   sdmmc_io_reset: unexpected return: 0x108   (ESP_ERR_TIMEOUT, ~15 times)
#   eh_sdio: ensure_slave_bus_ready failed: -1
# It is not a wrong pin nor incompatible C6 firmware: it is lack of power.
#
# With =n WiFi only comes up when tab5_wifi says so - after turning on the rail and
# waiting for the C6 to boot. The Kconfig help itself recommends n for apps that
# need to choose the moment of init.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n

# L2 cache: 128KB is the IDF default; the P4 accepts 256KB and 512KB. We went up to
# 256KB because the system draws a lot into a framebuffer that lives in PSRAM, and every
# cache hit is a PSRAM access that does not happen.
#
# The cost is internal RAM: L2MEM is split between cache and SRAM. It fits comfortably -
# the boot heap_init showed 384+99+18 KB free before the change.
#
# DO NOT go up to 512KB without measuring: in that range IDF changes the cache line from
# 64 to 128 bytes (Kconfig.cache lines 26-27), and a bigger line wastes
# bandwidth when access is scattered - it can get worse instead of better.
CONFIG_CACHE_L2_CACHE_256KB=y

# --- peer_data channel with the C6 ----------------------------------------
# An opaque byte pipe between P4 and C6, on top of Custom RPC. ESP-NOW
# will talk through it (esp_now does NOT link on the P4 - it only exists on the C6 side), and it is
# through it that the host confirms the link after flashing new firmware to the
# coprocessor, cancelling the automatic rollback.
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y

# --- esp_hosted task stacks in PSRAM ---------------------------------------
# The 6 esp_hosted tasks (sdio_rx_buf, sdio_read, sdio_write,
# sdio_process_rx, eh_rpc_tx, eh_rpc_rx) ALL come from the same 4 KB knob, and
# measured in use (tarefas) four of them use less than 1 KB: that was ~24 KB of
# internal SRAM tied up for ~8 KB of use. Lowering the knob does not work (eh_rpc_rx
# uses ~2.7 KB and would have no headroom); changing the PLACE does, with no patch to the
# component - it is what Espressif does in the P4 host examples.
# Safe here because none of them touches flash (the peer_data callbacks only
# copy into queues) and SDIO uses its own DMA buffers, never the stack.
# Cost: the monitor snapshot reads these stacks inside the critical section; measured with
# 'tarefas' (foto/pior) before and after.
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y

# --- WiFi buffers: THIS SIDE DECIDES, the C6 is the one that spends -------
# The C6's esp_hosted calls esp_wifi_init with the fields that come from here
# (get_merged_init_config: "always use value from host"). The CONFIG_ESP_WIFI_*
# in c6/sdkconfig do not apply to buffers, BA or CSI. The RAM spent is the C6's
# (~250 KB free at its boot); the P4 allocates none of this.
#
# Values from Espressif's performance table for P4 + C6 over 4-bit SDIO at
# 40 MHz (esp_hosted's docs/design/performance.md). The factory ones (10/32/32,
# window 6) limited each A-MPDU aggregate the router sends to 6 frames.
# TX_BA_WIN has no consumer in IDF 5.5 (the WiFi library uses its own
# internal value); it matches the table only for consistency.
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_RX_BA_WIN=32

# --- THE BLUE FLICKER, CAUSE 1: the screen stops being refreshed when someone
#     writes to flash ----------------------------------------------------------
#
# The DPI panel does not "send" the picture: a DMA (DW-GDMA) reads the framebuffer from PSRAM
# line by line, forever. And that DMA IS NOT CIRCULAR - it finishes every
# frame and is RE-ENABLED by an interrupt:
#
#   mipi_dsi_dma_trans_done_cb (esp_lcd_panel_dpi.c:70)
#     dw_gdma_channel_use_link_list(chan, link_list);
#     dw_gdma_channel_enable_ctrl(chan, true);      <- 64 times per second
#
# If that interrupt is late, the panel FIFO runs dry and the frame comes out BLUE.
#
# CONFIG_LCD_DSI_ISR_HANDLER_IN_IRAM already defaults to =y: the interrupt code lives in
# IRAM, so a cache miss does not delay it. But THAT IS NOT ENOUGH. When someone
# writes to flash - and nvs_commit() writes to flash - IDF calls
# spi_flash_disable_interrupts_caches_and_other_cpu(), which TURNS OFF the cache and,
# with it, every interrupt that was not registered as IRAM-safe. The DSI one was
# not. A sector erase takes tens of ms: two or three whole frames
# with nobody re-enabling the DMA.
#
# Who writes to NVS in this system: ajustes.cpp (brightness, wifi, keyboard, grove,
# screen timeout - the Settings app) and tab5_mesh (our node number). In other words: the
# flicker on leaving Settings was never memory bandwidth. It was this.
#
# CACHE_SAFE also selects DW_GDMA_ISR_IRAM_SAFE, which is the half that matters
# (the interrupt that re-enables the DMA is DW-GDMA's, not the DSI bridge's). It costs a few
# KB of IRAM and nothing else: M5GFX registers no callback on the DPI panel,
# so the "callback must be in IRAM" check has nothing to fail.
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y

# --- ROBUSTNESS FINE-TOOTH COMB ------------------------------

# STACK OVERFLOW, CAUGHT ON THE SPOT, NOT AT THE NEXT CONTEXT SWITCH.
#
# The default (CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY, already on) only notices
# the overflow when the scheduler switches task - and by then the damage is done,
# and what was left on the stack may already have been overwritten by whatever
# ran after the overflow. This uses the CPU's LAST hardware watchpoint
# to halt at the EXACT instant any of the last 32 bytes of the
# stack is overwritten - before the damage spreads.
#
# Cost: ~60 bytes less usable stack PER TASK (the headroom we already
# have - the largest stack here is the console's, 12288 bytes - absorbs that
# painlessly), and one fewer hardware watchpoint for anyone using JTAG/gdb. This
# project debugs through its own console (see console.cpp), not JTAG, so
# the watchpoint is not missed for anything else.
#
# TURNED OFF ON 06/11/2026 - IT WAS THE "SWITCHED ITSELF OFF" HANG. Caught in the act
# via JTAG (OpenOCD) with the device hung: on every task switch FreeRTOS
# arms the watchpoint with esp_cpu_set_watchpoint(), which asks the hardware whether
# there is a debugger (assist_debug_ll_is_debugger_active). With the bit set and no
# real debugger (seen with the USB cable on the Mac), it uses semihosting - an
# ebreak nobody answers - and panics in the IDLE0 task (core dump: mcause 3,
# PC in esp_cpu_set_watchpoint). Stack overflow protection remains:
# the FreeRTOS canary (CHECK_STACKOVERFLOW_CANARY) and -fstack-protector.
# The heap sentinel (tab5_heap_psram.cpp) arms slots 0 and 1 at boot only.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=n

# SILENT PANIC: writes the core dump and restarts without printing. The panic
# report went to USB character by character, up to 50 ms each, feeding the
# watchdogs: with the cable on the Mac and nobody reading the port, the device stayed
# "off" (screen dark) for hours without restarting (06/11/2026). The boot already
# shows the crash from the core dump (services/tab5_log.cpp,
# 'travamento' on the console), with the task, the PC and the stack.
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y

# BUFFER OVERFLOW AND MEMORY CORRUPTION (item on the improvements list).
#
# Stack canary (-fstack-protector): every function with a local array gets a
# sentinel value between the array and the return address; a snprintf/memcpy that
# goes past the array brings the system down ON RETURN from the function, with its name in the
# backtrace - instead of carrying on with a corrupted stack and crashing far away.
# Measured cost (27/10): see the CHANGELOG; a few % of code, no RAM.
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
#
# LIGHT heap poisoning: each block gets a mark before and after (8 B
# per allocation). Anyone writing outside their own block is caught in free() or in
# heap_caps_check_integrity (the console 'mem' command). COMPREHENSIVE also
# fills free memory and costs CPU on every malloc/free - left out.
CONFIG_HEAP_POISONING_LIGHT=y

# 128-BYTE L2 CACHE LINE - found while hunting the blue frame.
# Each cache miss/write-back becomes ONE PSRAM burst the size of the line, and
# PSRAM (HEX, 200MHz) pays a fixed command+latency cost per burst. With
# 64B that fixed cost weighs double for the same data: less useful bandwidth for
# the CPU and TWICE the transactions competing for the bus with the panel's DMA.
# Evidence that 128 is the expected value for this board:
#  - Espressif's Arduino sdkconfig for P4 (including esp32p4_es, for
#    chips of revision < 3 like ours) uses 128;
#  - M5GFX aligns cache sync to 128 (Panel_FrameBufferBase.cpp,
#    Cache_WriteBack_Addr: addr & ~127u) - it was written expecting 128.
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# IPC TASK STACK (ipc0/ipc1). The system monitor
# (services/tab5_monitor) flagged ipc0 with 448B free out of 1024: it runs what
# the other core asks for (interrupt, cache, clock change), and usage depends
# on who asks. 1536 gives real headroom; it costs 1KB of SRAM across both cores.
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536

# Camera: the ISP pipeline controller runs auto exposure and white
# balance (without it the picture comes out green and dark).
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# --- Bluetooth -------------------------------------------------
# The P4 HAS NO RADIO: the BLE controller is the C6's, and our C6 firmware is already
# born with it on (ESP_HOSTED_CP_FEAT_BT, HCI over VHCI - see c6/sdkconfig).
# Here only the STACK (NimBLE) comes up on the P4, plus the esp_hosted bridge, which carries the
# HCI packets over the same SDIO as WiFi. None of this requires reflashing the C6.
#
# Central (the Tab5 connects to Meshtastic, not the other way round) and peripheral
# off - only what is used comes up. Pairing with a PIN (Meshtastic requires it) and
# the bond stored in NVS, so it does not ask for the PIN on every restart.
#
# NimBLE's memory goes to PSRAM: internal SRAM is the most contended in the
# system, and BLE is not a real-time path here.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# --- Camera (SC202CS on MIPI-CSI) -----------------------------------------------
# The Tab5's sensor. Without these keys esp_cam_sensor does not compile its driver
# and the Camera app finds no sensor at all.
CONFIG_CAMERA_SC202CS=y
CONFIG_CAMERA_SC202CS_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
# The sensor's full frame. The 1280x720 mode is a window in the centre (80% x 60%
# of the field of view): the photo looked zoomed in.
CONFIG_CAMERA_SC202CS_MIPI_RAW8_1600X1200_30FPS=y
CONFIG_CAMERA_SC202CS_MIPI_DEFAULT_FMT_RAW8_1600X1200_30FPS=y
CONFIG_CAMERA_SC202CS_DIG_GAIN_PRIORITY=y
CONFIG_CAM_CTLR_MIPI_CSI_ISR_CACHE_SAFE=y
CONFIG_CAM_CTRL_SPI_ENABLE=n

# --- Panel DMA in IRAM ----------------------------------------------------------
# The DW-GDMA functions the panel ISR uses live in IRAM: with the cache
# off (flash write) they keep running and the screen does not flicker.
CONFIG_DW_GDMA_CTRL_FUNC_IN_IRAM=y
CONFIG_DW_GDMA_GETTER_FUNC_IN_IRAM=y
CONFIG_DW_GDMA_SETTER_FUNC_IN_IRAM=y

# --- Internal RAM: what leaves it ------------------------------------------------
# Internal SRAM (~320 KB of heap) is the most contended resource: stacks, queues,
# DMA buffers for the C6's SDIO and for the panel. See also main/linker.lf.
#
# mbedTLS in PSRAM. With INTERNAL, each TLS session (mqtts, https, the C6
# update over the network) takes ~40 KB of internal at once - the input buffer alone
# is 16 KB. Today MQTT is "mqtt://", but TLS support is compiled in, and the
# day it is turned on must not bring down the rest. The P4's hardware AES/SHA copes
# with a buffer in PSRAM (the driver copies through an internal bounce buffer when needed).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
#
# sys_evt stack (IDF's default event loop). WiFi's ao_evento logs
# and does RPC in there, and pilhas-*.csv showed 600 bytes free out of 2304 - too
# close to the end. This is not a saving: it is the only place that goes UP.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
#
# Ordinary malloc() up to 4 KB stays internal; above that it goes to PSRAM (the
# default was 16 KB). FreeRTOS stacks and objects do not go through here (they ask for
# internal explicitly), and anything doing DMA asks for MALLOC_CAP_DMA - so what
# moves are the ordinary 4 to 16 KB buffers, which occupied internal memory
# without needing it. Check with `mem mapa` (the <16K band of used blocks).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- Camera: our own SC202CS calibration ------------------------------------
# A copy of esp_cam_sensor's sc202cs_default.json with ONE change: auto exposure
# aims lower (brightness target 62 -> 52, range 56..64 -> 46..54)
# and reacts sooner to blown-out areas (high_threshold 239 -> 230, high_regions
# 3 -> 2). Reason: the P4's ISP applies the white balance gain and the colour
# matrix (CCM) WITHOUT clipping the excess first; on a white that saturates the sensor,
# red and blue go past 255 and the CCM's green row (-0.70 R + 2.08 G
# - 0.38 B) knocks the green down - white comes out magenta. Less exposure = fewer
# saturated pixels. To go back to the factory one: DEFAULT_IPA_JSON=y.
# The magenta fix itself is the protected matrix of our own IPA
# (main/hal/tab5_camera_ipa.c); the lower exposure only reduces the blown-out area.
# CONFIG_CAMERA_SC202CS_DEFAULT_IPA_JSON_CONFIGURATION_FILE is not set
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="main/hal/sc202cs_tab5.json"

# esp_hosted transport packet counters (7 integers): it is what the
# Wi-Fi dynamic power save (hal/tab5_wifi.cpp, TELA ACESA) reads to know whether
# there is traffic. Its periodic log is debug-level: once an hour.
CONFIG_ESP_HOSTED_HOST_PKT_STATS=y
CONFIG_ESP_HOSTED_HOST_PKT_STATS_INTERVAL_SEC=3600

# UI WATCHDOG: 10 s. While idle the ui task waits up to 5 s per cycle
# (the saving rhythm, kernel/core.cpp MEDIDA_MS); with the 5 s default the
# watchdog expired on every cycle ("task_wdt: - ui (CPU 1)" every 10 s in the log).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# CORE DUMP TO FLASH ('coredump' partition, partitions.csv): a crash leaves
# its snapshot recorded, and the next boot notes in the SD card log the task, the PC
# and the RA (services/tab5_log). ELF: it is the format that has the summary
# (esp_core_dump_get_summary) and that 'idf.py coredump-info' reads.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# --- THE C6 SLEEPING ASSOCIATED (hal/tab5_c6_sono) ---------------------------
# Enables the "host came back from power save" branch of SDIO bring-up (redoes the card
# without resetting the C6). WITHOUT auto-initialisation: it arms an interrupt on G14
# that RESTARTS the P4 - made for a host in deep sleep. The one listening to G14 here is
# hal/tab5_c6_sono.cpp.
CONFIG_ESP_HOSTED_HOST_FEAT_POWER_SAVE=y
CONFIG_ESP_HOSTED_HOST_FEAT_POWER_SAVE_AUTO_INIT=n

# --- WEB SERVER WITH WEBSOCKET (services/tab5_web) ---------------------------
# The terminal in the browser (the shared SSH) sends and receives keystroke by keystroke:
# WebSocket. The pre-handshake hook is where the gatekeeper checks local
# network, password and the ORIGIN (the X-Tab5 header does not exist in WebSocket).
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# A WebSocket connection stays open the whole time; with SSH, MQTT and NTP also
# in use, 10 sockets were tight (httpd reserves 3).
CONFIG_LWIP_MAX_SOCKETS=16

# TCP WINDOW (06/11/2026): the default of 5760 B (4 packets) limited downloads to
# window / round trip = 5760 / ~75 ms = ~77 KB/s - exactly what was measured from
# Cloudflare. Measured on the Tab5: 16 packets (23040) gave 334 KB/s but the minimum of
# internal RAM dropped from ~138 to ~80 KB (the SDIO DMA buffers with the C6
# grow with the window; moving lwIP to PSRAM did not change that). 8 packets is
# the middle ground. The receive mailbox must fit the window.
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# --- IDF CODE OUT OF IRAM (optimisation plan, Phase 1, 12/11/2026) --------------
# IRAM is the same internal SRAM as the heap: every KB of code that leaves it becomes
# heap, and at the START of the region - it increases the largest block, not just the total. Here only
# the options IDF itself gives as safe: functions that are NOT called from
# interrupts (the ...FromISR versions stay in IRAM). With the cache off
# (flash write) only IDF runs, and it does not use these.
# - FreeRTOS: up to 8 KB (xTaskCreate, queues, semaphores - the task-level ones).
# - ringbuf : the ring buffer's task-level functions (UART, console USB);
#             the interrupt ones stay.
# NOT enabled (on purpose): HEAP_PLACE_FUNCTION_INTO_FLASH - it requires that
# no ISR in IRAM calls malloc/free, and third-party drivers (esp_hosted,
# M5GFX) have not been checked.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# --- WITHOUT THE 32 KB INTERNAL RESERVE (Phase 1, 12/11/2026) -------------------
# IDF sets aside 32 KB of internal SRAM "for emergencies" (DMA and stacks, in case
# malloc fills internal memory). Measured with 'mem mapa' at boot, in Music, in Video
# and on the home screen: the reserve becomes a region of its own with 0 KB used - it was never
# touched (the lowest internal minimum ever seen stays above 100 KB). And it is taken
# from the LARGE region (the "high" one, 0x4FF40000), splitting it: it was the main reason for the
# small "largest block". Without the reserve, the 32 KB go back to the large region.
# Whoever needs a guarantee in internal memory (H.264 arena, 80 KB floor) already
# checks its own floor; the monitor shows the internal minimum.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0
