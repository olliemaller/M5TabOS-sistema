# P4 REVISION v3.x (M5_CHIP=v3). Added to sdkconfig.defaults by the
# root CMakeLists.txt. Build:
#     idf.py -B build_v3 -DM5_CHIP=v3 build
# (or ./gravar.sh, which reads the device's revision and chooses by itself).
#
# IDF warns in its own Kconfig: v3.0 onwards and v1.x have a "huge hardware
# difference" - a binary for one does NOT run on the other (the bootloader rejects the
# revision). Nothing in the system code depends on the revision except the maximum clock
# (400 MHz here, 360 on v1 - read from CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ, see
# TAB5_CPU_MAX_MHZ in hal/tab5_power.hpp).
#
# THIS PROFILE BUILDS, BUT HAS NOT BEEN TESTED ON A DEVICE: we do not have a P4 v3.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
