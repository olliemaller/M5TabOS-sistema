# STATICS OF APPS AND SERVICES IN PSRAM, WITHOUT TOUCHING THE FILES.
#
# The .bss of each file in this list (static and global variables with no
# initial value) leaves internal SRAM and goes to the .ext_ram.bss section, in PSRAM. It is the
# same effect as marking each variable with EXT_RAM_BSS_ATTR, but per whole
# file: a new array someone adds to an app is born in the right place already.
#
# WHY IT MATTERS. The P4's internal SRAM is ~320 KB of heap and from it
# come the stacks of ALL tasks, the FreeRTOS queues, the DMA buffers of the
# C6's SDIO and the panel's. Every KB of internal .bss is one KB less for that,
# forever - including the buffers of an app that is closed. There were
# ~75 KB in that situation here (monitor history, Trilha map points, Radar
# targets, MQTT frames...).
#
# RULE FOR GETTING ON THE LIST. The file may NOT have ANY variable that is
#   - read or written inside an ISR (IRAM_ATTR): during a flash write the
#     cache is off and PSRAM disappears; an ISR touching it would hang;
#   - a DMA buffer: the L2 cache line is 128 B and DMA requires alignment
#     to it in PSRAM (see the blue flicker);
#   - portMUX / StaticSemaphore_t / StaticTask_t / a task stack: locks and
#     stacks stay internal.
# Checked file by file. LEFT OUT, on purpose: pool_tarefas
# (stacks), tab5_marcos (DRAM_ATTR, read with the cache off), tab5_tela and
# tab5_quadro (DSI ISR), tab5_camera (ISR), core (touch ISR), tab5_power,
# tab5_sd, tab5_log, tab5_donos and fundo (portMUX), and app_cobra, which is not
# touched from here.
#
# TO CHECK after building: the file leaves the DIRAM list of
#   idf.py size-files
# and starts appearing under "External RAM".

# IDF's "extram_bss" scheme lives in esp_wifi/linker.lf, which does NOT go into
# the P4 build (WiFi runs on the C6, esp_wifi here does not compile). Without it the
# mapping below matched nothing and ldgen stayed silent - the .bss
# stayed internal. That is why the scheme is declared here, the same as its:
# the file's .bss and COMMON sections go to the extern_ram target of sections.ld.
[scheme:m5tabos_extram_bss]
entries:
  bss -> extern_ram
  common -> extern_ram

[mapping:m5tabos_extram_bss]
archive: libmain.a
entries:
  if SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
    # apps (only the UI task and the app's own slot touch this)
    app_arquivos (m5tabos_extram_bss)
    app_azimutal (m5tabos_extram_bss)
    app_config (m5tabos_extram_bss)
    app_config_icones (m5tabos_extram_bss)
    app_config_rede (m5tabos_extram_bss)
    app_config_paginas (m5tabos_extram_bss)
    app_energia (m5tabos_extram_bss)
    app_espnow (m5tabos_extram_bss)
    app_exemplo (m5tabos_extram_bss)
    app_imu (m5tabos_extram_bss)
    app_mesh (m5tabos_extram_bss)
    app_mesh_desenho (m5tabos_extram_bss)
    app_mesh_conversa (m5tabos_extram_bss)
    app_mesh_no (m5tabos_extram_bss)
    app_musica (m5tabos_extram_bss)
    app_video (m5tabos_extram_bss)
    app_notas (m5tabos_extram_bss)
    app_terminal (m5tabos_extram_bss)
    terminal_ssh (m5tabos_extram_bss)
    app_editor (m5tabos_extram_bss)
    minimp3_impl (m5tabos_extram_bss)
    app_radar (m5tabos_extram_bss)
    app_tarefas (m5tabos_extram_bss)
    app_trilha (m5tabos_extram_bss)
    # services (own tasks, no ISR)
    tab5_monitor (m5tabos_extram_bss)
    tab5_mesh (m5tabos_extram_bss)
    tab5_mesh_hora (m5tabos_extram_bss)
    tab5_mesh_nos (m5tabos_extram_bss)
    tab5_mesh_conversas (m5tabos_extram_bss)
    tab5_mesh_canais (m5tabos_extram_bss)
    tab5_mesh_receber (m5tabos_extram_bss)
    tab5_mesh_gps (m5tabos_extram_bss)
    tab5_mesh_mqtt (m5tabos_extram_bss)
    tab5_mesh_ble (m5tabos_extram_bss)
    tab5_espnow (m5tabos_extram_bss)
    tab5_wifi (m5tabos_extram_bss)
    tab5_ble (m5tabos_extram_bss)
    tab5_gps (m5tabos_extram_bss)
    tab5_musica (m5tabos_extram_bss)
    tab5_musica_nomes (m5tabos_extram_bss)
    tab5_musica_decod (m5tabos_extram_bss)
    tab5_musica_espectro (m5tabos_extram_bss)
    tab5_musica_pasta (m5tabos_extram_bss)
    tab5_musica_duracao (m5tabos_extram_bss)
    tab5_musica_capa (m5tabos_extram_bss)
    tab5_musica_rede (m5tabos_extram_bss)
    # image and GIF: worker task, no ISR or DMA (the reader buffer is heap)
    tab5_imagem (m5tabos_extram_bss)
    tab5_gif (m5tabos_extram_bss)
    tab5_gif_nucleo (m5tabos_extram_bss)
    tab5_video (m5tabos_extram_bss)
    tab5_h264 (m5tabos_extram_bss)
    tab5_terminal (m5tabos_extram_bss)
    # Phase 4 (12/11): engine moved out of the Trilha, Azimutal and Arquivos apps.
    # Background task and worker; no ISR or DMA.
    tab5_trilha (m5tabos_extram_bss)
    tab5_gnss (m5tabos_extram_bss)
    tab5_linhas (m5tabos_extram_bss)
    tab5_texto (m5tabos_extram_bss)
    tab5_rede (m5tabos_extram_bss)
    tab5_ssh (m5tabos_extram_bss)
    tab5_web (m5tabos_extram_bss)
    tab5_web_portal (m5tabos_extram_bss)
    tab5_camera_web (m5tabos_extram_bss)
    tab5_mesh_web (m5tabos_extram_bss)
    tab5_terminal_web (m5tabos_extram_bss)
    tab5_grove (m5tabos_extram_bss)
    nmea (m5tabos_extram_bss)
    # Camera IPA (ISP task and console). Its portMUX has a non-zero
    # initial value: it goes to .data, which stays internal.
    tab5_camera_ipa (m5tabos_extram_bss)
    registro (m5tabos_extram_bss)
    notificacao (m5tabos_extram_bss)
    # UI (font tables and text measurements)
    tab5_ui (m5tabos_extram_bss)
    conversa (m5tabos_extram_bss)
    # lock-screen animations (only the UI task draws; no ISR or DMA)
    bloqueio_anim (m5tabos_extram_bss)
    bloqueio_anim_bolas (m5tabos_extram_bss)
    bloqueio_anim_fogos (m5tabos_extram_bss)
    bloqueio_anim_chuva (m5tabos_extram_bss)
    bloqueio_anim_estrelas (m5tabos_extram_bss)
    bloqueio_anim_bolhas (m5tabos_extram_bss)
    bloqueio_anim_cobra (m5tabos_extram_bss)
    bloqueio_anim_vagalumes (m5tabos_extram_bss)
    bloqueio_anim_pendulos (m5tabos_extram_bss)
    bloqueio_anim_neve (m5tabos_extram_bss)
    bloqueio_anim_cometas (m5tabos_extram_bss)
    bloqueio_anim_solar (m5tabos_extram_bss)
    bloqueio_anim_logo (m5tabos_extram_bss)
    # console (own task, no ISR). It writes to NVS, but that only
    # forbids a STACK in PSRAM, not .bss: the flash write copies what comes from
    # PSRAM through an internal buffer.
    console (m5tabos_extram_bss)
    # The console commands, one file per subject (main/console/): only the
    # console task runs them. Checked (12/11/2026): no portMUX, ISR,
    # stack or static DMA buffer - console_sistema's DMA is heap.
    # It was ~9 KB of text and snapshots (memory map, C6 power) that
    # stayed internal forever.
    console_bancada (m5tabos_extram_bss)
    console_cartao (m5tabos_extram_bss)
    console_mesh (m5tabos_extram_bss)
    console_rede (m5tabos_extram_bss)
    console_shell (m5tabos_extram_bss)
    console_sistema (m5tabos_extram_bss)
    console_tela (m5tabos_extram_bss)
    console_testes (m5tabos_extram_bss)
    # Berry (only the berry variant compiles it; in the others the line matches
    # nothing). The app slots, the camera and the script keyboard: ~9 KB that
    # stayed internal forever. Only the UI and the Berry task -
    # whose stack is already PSRAM - touch this.
    berry_apps (m5tabos_extram_bss)
    berry_vm (m5tabos_extram_bss)
    berry_web (m5tabos_extram_bss)
    berry_scripts (m5tabos_extram_bss)

# IDF's lwIP asks for the same (lwip/linker.lf: "* (extram_bss)" when .bss
# may go to PSRAM) and fell into the same hole of the missing scheme. IDF already
# considers lwIP's .bss safe outside internal memory; here we just carry out what it
# intended.
[mapping:m5tabos_lwip_extram_bss]
archive: liblwip.a
entries:
  if SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
    * (m5tabos_extram_bss)
